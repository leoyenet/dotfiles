# Ignore everything unless explicitly kept below.
/*
!/.gitignore
!/README.md
!/.luarc.json
!/mimeapps.list
!/starship.toml

# Core application configs.
!/fish/
!/hypr/
!/just/
!/noctalia/
!/nvim/
!/spicetify/
!/yazi/
!/zed/

# Machine-local state and generated application data.
/fish/fish_variables
/fish/fish_history
/fish/fish_read_history
/spicetify/Backup/
/spicetify/backups/
/spicetify/Extracted/

# Credentials and local environment overrides; keep shareable examples.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
/gh/hosts.yml
/glab-cli/config.yml
/rclone/rclone.conf

# Generated caches and logs.
**/.cache/
**/node_modules/
*.log
*.log.*

# Editor temporary files.
*.swp
*.swo
*~
/nvim/doc/tags
